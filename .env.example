# Only needed for the Node/Bun harness in harness/. The extension asks for the key in its UI.
ANTHROPIC_API_KEY=
# Optional: standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=

# Local Tencent Meeting integration. Keep secrets in .env, never in generated pages.
# Falls back to a fixed MA_UPSTREAM_API_KEY when omitted.
MA_TMEET_API_KEY=
# Exact unpacked extension origin(s), comma separated.
MA_TMEET_ORIGINS=
# Optional native CLI path; Windows npm installations are detected automatically.
MA_TMEET_EXECUTABLE=
# Optional local proxy. Existing HTTP(S)_PROXY environment variables are inherited.
MA_TMEET_PROXY=http://127.0.0.1:7897
